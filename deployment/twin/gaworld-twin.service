[Unit]
Description=GAWorld mobile digital twin
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/GAWorld-twin
# Keep existing reports/bindings independent of the dashboard's selected city.
Environment="GAWORLD_CONFIG_OVERRIDES={\"twin\":{\"root\":\"%h/GAWorld-twin/output/twin\",\"bindings_path\":\"%h/GAWorld-twin/data/twin_bindings.json\"}}"
ExecStart=%h/GAWorld/.venv-deploy/bin/python -u -m gaworld.apps.twin_server --host 0.0.0.0 --port 8767
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
