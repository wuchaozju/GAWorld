\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The GAWorld Console. The left navigation exposes every v2 surface: \emph  {Cities} and \emph  {Population} build the city bundle; \emph  {Organizations} edits rules and members; \emph  {Agent Studio} shapes individual residents; the \emph  {Dashboard} (shown) configures and starts a run; the \emph  {Playground}, \emph  {Play Together}, and \emph  {Group Interview} tabs run game-based probes, an open-world player lease, and one-shot elicitation; \emph  {External} drives the relay and external-environment services; and \emph  {Analytics} / \emph  {Research} surface the result inspection and the counterfactual / paper-to-protocol workflows. The screenshot was captured against the bundled Keqiao (Shaoxing) city bundle in single-tenant, single-process mode; the dashboard UI was switched to English via \texttt  {window.setLocale('en')}, while the resident content reflects the language of the bundled data.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:console}{{1}{3}{The GAWorld Console. The left navigation exposes every v2 surface: \emph {Cities} and \emph {Population} build the city bundle; \emph {Organizations} edits rules and members; \emph {Agent Studio} shapes individual residents; the \emph {Dashboard} (shown) configures and starts a run; the \emph {Playground}, \emph {Play Together}, and \emph {Group Interview} tabs run game-based probes, an open-world player lease, and one-shot elicitation; \emph {External} drives the relay and external-environment services; and \emph {Analytics} / \emph {Research} surface the result inspection and the counterfactual / paper-to-protocol workflows. The screenshot was captured against the bundled Keqiao (Shaoxing) city bundle in single-tenant, single-process mode; the dashboard UI was switched to English via \texttt {window.setLocale('en')}, while the resident content reflects the language of the bundled data}{figure.1}{}}
