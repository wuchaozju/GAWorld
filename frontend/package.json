    "test:e2e:real": "playwright test e2e/real-llm.spec.ts --project=en",
    "test:i18n": "vitest run __tests__/i18n.strict.test.ts",
    "test:i18n:audit": "vitest run __tests__/i18n.audit.test.ts"
  },
