# =====================================================================
# GAWorld environment variables (example)
# Copy to `.env` and fill in the values you need for your environment.
# Loaded automatically by `gaworld.env_loader` on import.
# Never commit your real `.env` file.
# =====================================================================

# ---- LLM providers --------------------------------------------------
# Personal-key mode for multi-user servers: absolute path OUTSIDE Git.
# Dedicated parent directory must be 0700; file is created as 0600.
# Each signed-in account supplies its own key. No shared environment-key fallback.
GAWORLD_LLM_SECRETS_PATH=

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=

# Anthropic (also used by Minimax China-region endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Minimax convenience
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_AUTHORIZATION_SCHEME=raw

# Local OMLX (OpenAI-compatible MLX server)
OMLX_API_KEY=omlx-local

# ---- Runtime overrides ----------------------------------------------
# Optional JSON blob deeply merged into CONFIG at import time.
# Example: GAWORLD_CONFIG_OVERRIDES='{"sim_days":3,"agent_ids":[1,2]}'
GAWORLD_CONFIG_OVERRIDES=

# ---- Logging --------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
GAWORLD_LOG_LEVEL=INFO

# Where to mirror application logs. Defaults to output/logs/run.log.
GAWORLD_LOG_FILE=
