        "timeout": 600
      },
      "MiniMax-M3": {
        "type": "anthropic",
        "base_url": "https://api.minimaxi.com/anthropic",
        "model": "MiniMax-M3",
        "api_key_env": "MINIMAX_API_KEY",
        "authorization_scheme": "raw",
        "include_x_api_key": true,
        "max_tokens": 4096,
        "timeout": 180
      },
      "M31Flash": {
        "type": "anthropic",
        "base_url": "https://api.minimaxi.com/anthropic",
        "model": "M3.1-Flash",
        "api_key_env": "MINIMAX_API_KEY"
      }
    }
  },
  "sim_days": 5,
  "seconds_per_day": 10,
  "agent_ids": [
    1,
    2,
    3
  ],
  "simulate_realtime": true,
  "time_step_minutes": null,
  "long_run": {
    "enabled": false,
    "randomness": 1.0,
    "unit": "day"
  },
  "routine_change": {
    "randomness": 1.0
  },
  "city": "伦敦"
