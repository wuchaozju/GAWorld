  "items": [
    {
      "id": "R1.1",
      "dim": "R1",
      "unit": "agent_day",
      "checker": "hybrid",
      "weight": 1,
      "requires": [
        "episodes"
      ],
      "proposition": "记忆可溯源：决策中引用的往事真实存在于此前 episodes，且未被篡改",
      "anchors": {
        "0": "引用了不存在或与史实矛盾的往事",
        "1": "往事存在但引用牽强、与当日决策无关",
        "2": "往事存在、准确，且构成当日决策的理由"
      },
      "failure_modes": [
        "泛化回忆（“最近一直挺忙”）冒充具体记忆",
        "回忆内容与原 episode 细节不符"
      ],
      "evidence_fields": [
        "recollections",
        "change_reason",
        "decision_driver"
      ],
      "ablations": [
        "N1"
      ]
    },
    {
      "id": "R1.2",
      "dim": "R1",
      "unit": "agent_day",
      "checker": "llm",
      "weight": 1,
      "requires": [
        "episodes"
      ],
      "proposition": "动机可解释：计划活动到实际活动的偏离有具体理由，且与当时的需求/状态一致",
      "anchors": {
        "0": "无理由，或理由与需求/状态直接矛盾",
        "1": "理由是套话（“根据实际情况调整”之类），无实质信息",
        "2": "理由具体，且能从需求快照或状态变量推出"
      },
      "failure_modes": [
        "change_reason 模板化",
        "所有偏离都归因于天气"
      ],
      "evidence_fields": [
        "scheduled_activity",
        "final_activity",
        "change_reason",
        "need_snapshot",
        "state_before"
      ],
      "ablations": [
        "N2"
      ]
    },
